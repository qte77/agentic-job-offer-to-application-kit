# Generated outputs at the repo root — never committed. Anchored to the repo root (leading /)
# so the committed example under examples/ (which mirrors config/ + results/) is unaffected.
/results/*
!/results/.gitkeep
/library/
/input/

# Real config at the repo root is git-ignored; the directory is kept via .gitkeep.
# Covers seed.json + future PII-bearing portfolio.md / work-history.md / cv + cover-letter samples.
# Exception: the shipped, ToS-vetted config/default-seed.json IS tracked (the ingest fallback).
/config/*
!/config/.gitkeep
!/config/default-seed.json

# Python / tooling
__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.coverage
