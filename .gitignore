# Generated / PII-bearing dirs — ignored at ANY depth (defensive: a run that writes to a nested
# results/ or config/ is caught too, not just the repo root). Re-included: the synthetic
# examples/*/ copies, plus at the repo root the .gitkeep dir-keepers and the shipped, ToS-vetted
# config/default-seed.json (the ingest fallback). The root re-include + contents-ignore pair is
# needed because a file under a directory excluded by `config/` cannot otherwise be re-included.
results/
config/
/library/
/input/
!examples/*/results/
!examples/*/config/
!/results/
/results/*
!/results/.gitkeep
!/config/
/config/*
!/config/default-seed.json
!/config/.gitkeep

# Python / tooling
__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.coverage
