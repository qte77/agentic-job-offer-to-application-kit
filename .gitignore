# Generated / PII-bearing dirs — ignored at ANY depth (defensive: a run that writes to a nested
# results/ or config/ is caught too, not just the repo root). The synthetic examples/*/ fixtures are
# re-included so NEW example files can be added without -f. Everything already committed inside
# (results/.gitkeep, config/.gitkeep, and the shipped config/default-seed.json) STAYS tracked
# regardless — git never untracks a tracked file — so no per-file re-include dance is needed.
results/
# Generated but PII-FREE: the publishable aggregate trends (#210). Reaches the `data` branch only via
# `git add -f` (the `make trends_data` tree-allowlist guard asserts ONLY these files are pushed).
public-data/
config/
/library/
/input/
!examples/*/results/
!examples/*/config/

# Python / tooling
__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.coverage
.complexipy_cache/
.hypothesis/

# Local dotenv override read by AppSettings (env_file) — keep private AJOA_* paths out of git
.env
