// markdownlint-cli2 runner + rule config (consolidated; the rules previously
// lived in a separate .markdownlint.jsonc). One file suffices: CI runs
// markdownlint-cli2-action inline (the org `lint-md-links` reusable workflow is
// not callable from this repo's Actions settings — see lint-md-links.yml), so
// nothing needs to detect a standalone .markdownlint.jsonc. markdownlint-cli2
// auto-discovers this file and honors the `config` key for rules; `make
// docs-lint` passes globs explicitly on the CLI.
{
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    "node_modules/**",
    ".git/**",
    ".venv/**",
    "changelog.d/**"
  ],
  "config": {
    "default": true,
    "MD013": false,            // line length — URL-rich tables make this counterproductive
    "MD024": { "siblings_only": true },   // duplicate headings OK across different sections
    "MD033": false,            // inline HTML OK (used for <details>, <https://...>, <br>)
    "MD041": false,            // first line need not be H1 (LICENSE/CHANGELOG style)
    "MD060": { "style": "padded" }        // | col | col | (not |col|col|)
  }
}
