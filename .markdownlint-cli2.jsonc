// markdownlint-cli2 options: file globs + ignores. The markdown RULE config
// lives in .markdownlint.jsonc (so the shared lint-md-links CI workflow reuses
// it); markdownlint-cli2 merges both files.
{
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    "node_modules/**",
    ".git/**",
    ".venv/**",
    "changelog.d/**"
  ]
}
